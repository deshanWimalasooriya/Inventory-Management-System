<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="main-content" stylesheets="@../css/global.css, @../css/inventory.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.supermarket.pos.InventoryController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <!-- HEADER WITH REAL-TIME SEARCH -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Database Stock Viewer" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchField" promptText="🔍 Search name or barcode..." styleClass="scanner-input" prefWidth="300" />
        <Button text="🔄 Refresh" styleClass="nav-btn" style="-fx-border-color: #334155; -fx-border-radius: 8px; -fx-padding: 10 15;" onAction="#loadInventoryData"/>
    </HBox>

    <!-- TABLE WITH CONSTRAINED RESIZE (Fixes empty right column) -->
    <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colBarcode" text="Barcode" />
            <TableColumn fx:id="colName" text="Product Name" />
            <TableColumn fx:id="colPrice" text="Unit Price ($)" style="-fx-alignment: CENTER-RIGHT;"/>
            <TableColumn fx:id="colStock" text="Current Stock" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>

    <!-- BOTTOM ACTION BAR -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 8px; -fx-border-color: #334155; -fx-border-radius: 8px;">
        <Label text="Quick Add Stock:" styleClass="section-title" style="-fx-font-size: 16px;"/>
        <TextField fx:id="txtUpdateBarcode" promptText="Scan or Type Barcode" styleClass="scanner-input" prefWidth="220"/>
        <TextField fx:id="txtAddQty" promptText="Qty" prefWidth="90" styleClass="scanner-input"/>
        <Button text="Add to Inventory" styleClass="checkout-btn" onAction="#handleUpdateStock"/>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblStatus" text="" style="-fx-text-fill: #10b981; -fx-font-weight: bold;"/>
    </HBox>
</VBox>